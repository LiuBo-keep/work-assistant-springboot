<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">

    <changeSet id="202605141527" author="aidan.liu">
        <createTable tableName="hrms_card_record">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="hrms_card_record_pkey"/>
            </column>
            <column name="employee_id" type="VARCHAR(255)"/>
            <column name="cn_name" type="VARCHAR(255)"/>
            <column name="en_name" type="VARCHAR(255)"/>
            <column name="clock_in_date" type="DATE"/>
            <column name="clock_in_time" type="TIMESTAMP WITHOUT TIME ZONE"/>
            <column name="clock_in_type" type="VARCHAR(255)"/>
            <column name="version_num" type="INTEGER"/>
        </createTable>
    </changeSet>

    <changeSet id="202605141542" author="aidan.liu">
        <createTable tableName="hrms_notify_config">
            <column name="id" type="VARCHAR(255)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="hrms_notify_config_pkey"/>
            </column>
            <column name="enabled" type="BOOLEAN"/>
            <column name="notify_channel" type="VARCHAR(255)"/>
            <column name="push_plus_url" type="VARCHAR(255)"/>
            <column name="push_plus_token" type="VARCHAR(255)"/>
            <column name="ding_talk_url" type="VARCHAR(255)"/>
            <column name="hrms_url" type="VARCHAR(255)"/>
            <column name="hrms_token" type="VARCHAR(255)"/>
            <column name="version_num" type="INTEGER"/>
        </createTable>
    </changeSet>
</databaseChangeLog>